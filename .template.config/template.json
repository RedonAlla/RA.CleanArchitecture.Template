{
  "$schema": "http://json.schemastore.org/template",
  "author": "Redon Alla",
  "classifications": ["web", "api"],
  "identity": "RA.CleanArchitecture.Template",
  "groupIdentity": "RA.CleanArchitecture.Template",
  "name": "Clean Architecture Solution",
  "shortName": "RA.Template",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "defaultName": "RaTemplate",
  "sourceName": "RaTemplate",
  "description": "Template for building Web Api with Clean Architecture",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "displayName": ".NET Target Framework",
      "description": "Select the target framework for the project.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "displayName": ".NET 10",
          "description": "Use .NET 10 Target framework for your project"
        }
      ],
      "replaces": "net10.0",
      "defaultValue": "net10.0"
    },
    "UseAuthorization": {
      "type": "parameter",
      "description": "Use JWT Authorization",
      "displayName": "JWT Authorization",
      "defaultValue": "true",
      "datatype": "bool"
    },
    "UseIntegrations": {
      "type": "parameter",
      "displayName": "Use HTTP Client Integration?",
      "description": "Add infrastructure to build HTTP Clients Integration.",
      "defaultValue": "true",
      "datatype": "bool"
    },
    "OpenApiUI": {
      "type": "parameter",
      "displayName": "OpenApi documentation UI.",
      "description": "Select UI for OpenApi documentation.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "scalar",
          "displayName": "Scalar",
          "description": "Use Scalar as UI for API documentation and tests."
        }
      ],
      "defaultValue": "scalar"
    },
    "Database": {
      "type": "parameter",
      "displayName": "Database type",
      "description": "Select the Database types you want to use in your application.",
      "datatype": "choice",
      "allowMultipleValues": true,
      "choices": [
        {
          "choice": "EfSqlServer",
          "displayName": "EF with SQL Server",
          "description": "Use Entity Framework with SQL Server"
        },
        {
          "choice": "EfOracle",
          "displayName": "EF with Oracle",
          "description": "Use Entity Framework with Oracle"
        }
      ],
      "defaultValue": ""
    },
    "UseScalarUI": {
      "type": "computed",
      "value": "(OpenApiUI == \"scalar\")"
    },
    "UseEfSqlServer": {
      "type": "computed",
      "value": "Database.indexOf('EfSqlServer') > -1"
    },
    "UseEfOracle": {
      "type": "computed",
      "value": "Database.indexOf('EfOracle') > -1"
    },
    "UseAnyDatabase": {
      "type": "computed",
      "value": "Database.length > 0"
    }
  },
  "sources": [
    {
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**/*",
        "**/*.filelist",
        "**/*.user",
        "example/**",
        "README.md",
        "CLAUDE.md"
      ],
      "rename": {
        "README-template.md": "README.md",
        "CLAUDE-template.md": "CLAUDE.md"
      },
      "modifiers": [
        {
          "condition": "(!UseAuthorization)",
          "exclude": [
            "src/Presentation/RaTemplate.Api/Extensions/AuthorizationExtensions.cs"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "src/Presentation/RaTemplate.Api/RaTemplate.Api.csproj" },
    { "path": "src/Presentation/RaTemplate.Api/README.md" }
  ],
  "postActions": [
    {
      "actionId": "D396686C-DE0E-4DE6-906A-29C1699A8DB6",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [ { "text": "Run 'dotnet restore'" } ],
      "continueOnError": true
    },
    {
      "description": "Opens README.md in the editor",
      "manualInstructions": [ ],
      "actionId": "84C0DA21-51C8-4541-9940-6CA19AF04EE6",
      "args": {
        "files": "1"
      },
      "continueOnError": true
    }
  ]
}