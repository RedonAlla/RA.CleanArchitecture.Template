{
  "$schema": "http://json.schemastore.org/template",
  "author": "Redon Alla",
  "classifications": ["web", "api"],
  "identity": "RA.CleanArchitecture.Template",
  "groupIdentity": "RA.CleanArchitecture.Template",
  "name": "Clean Architecture Solution",
  "shortName": "RA.Template",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "defaultName": "RaTemplate",
  "sourceName": "RaTemplate",
  "description": "Template for building Web Api with Clean Architecture",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "displayName": ".NET Target Framework",
      "description": "Select the target framework for the project.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "displayName": ".NET 10",
          "description": "Use .NET 10 Target framework for your project"
        }
      ],
      "replaces": "net10.0",
      "defaultValue": "net10.0"
    },
    "UseAuthorization": {
      "type": "parameter",
      "description": "Use JWT Authorization",
      "displayName": "JWT Authorization",
      "defaultValue": "true",
      "datatype": "bool"
    },
    "UseIntegrations": {
      "type": "parameter",
      "displayName": "Use HTTP Client Integration?",
      "description": "Add infrastructure to build HTTP Clients Integration.",
      "defaultValue": "true",
      "datatype": "bool"
    },
    "OpenApiUI": {
      "type": "parameter",
      "displayName": "OpenApi documentation UI.",
      "description": "Select UI for OpenApi documentation.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "scalar",
          "displayName": "Scalar",
          "description": "Use Scalar as UI for API documentation and tests."
        },
        {
          "choice": "swagger",
          "displayName": "Swagger",
          "description": "Use Swagger UI as UI for API documentation and tests."
        }
      ],
      "defaultValue": "scalar"
    },
    "Database": {
      "type": "parameter",
      "displayName": "Database provider",
      "description": "Select the database provider(s) you want to use in your application. Multiple providers can be selected (one DbContext per provider).",
      "datatype": "choice",
      "allowMultipleValues": true,
      "choices": [
        {
          "choice": "EfSqlServer",
          "displayName": "EF with SQL Server",
          "description": "Use Entity Framework with SQL Server"
        },
        {
          "choice": "EfOracle",
          "displayName": "EF with Oracle",
          "description": "Use Entity Framework with Oracle"
        },
        {
          "choice": "EfPostgres",
          "displayName": "EF with PostgreSQL",
          "description": "Use Entity Framework with PostgreSQL"
        },
        {
          "choice": "EfSqlite",
          "displayName": "EF with SQLite",
          "description": "Use Entity Framework with SQLite"
        },
        {
          "choice": "None",
          "displayName": "None",
          "description": "Do not use a database (the Persistence project is not generated). Select it alone."
        }
      ],
      "defaultValue": "EfSqlServer"
    },
    "UseScalarUI": {
      "type": "computed",
      "value": "(OpenApiUI == \"scalar\")"
    },
    "UseSwaggerUI": {
      "type": "computed",
      "value": "(OpenApiUI == \"swagger\")"
    },
    "UseEfSqlServer": {
      "type": "computed",
      "value": "(Database == \"EfSqlServer\")"
    },
    "UseEfOracle": {
      "type": "computed",
      "value": "(Database == \"EfOracle\")"
    },
    "UseEfPostgres": {
      "type": "computed",
      "value": "(Database == \"EfPostgres\")"
    },
    "UseEfSqlite": {
      "type": "computed",
      "value": "(Database == \"EfSqlite\")"
    },
    "UseAnyDatabase": {
      "type": "computed",
      "value": "(UseEfSqlServer || UseEfOracle || UseEfPostgres || UseEfSqlite)"
    }
  },
  "sources": [
    {
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/.git/**",
        ".git/**",
        ".template.config/**/*",
        "**/*.filelist",
        "**/*.user",
        "example/**",
        ".claude/settings.local.json",
        ".vscode/**",
        "docs/**",
        "**/.DS_Store",
        "README.md",
        "CLAUDE.md"
      ],
      "rename": {
        "README-template.md": "README.md",
        "CLAUDE-template.md": "CLAUDE.md"
      },
      "modifiers": [
        {
          "condition": "(!UseAuthorization)",
          "exclude": [
            "src/Presentation/RaTemplate.Api/ServiceConfiguration/AuthorizationExtensions.cs"
          ]
        },
        {
          "condition": "(!UseAnyDatabase)",
          "exclude": [
            "src/Infrastructure/RaTemplate.Persistence/**",
            "src/Core/RaTemplate.Application/Abstractions/Data/**",
            "tests/RaTemplate.ArchitectureTests/PersistenceTests.cs"
          ]
        },
        {
          "condition": "(!UseEfSqlServer)",
          "exclude": [
            "src/Infrastructure/RaTemplate.Persistence/Database/Schemas.cs",
            "src/Infrastructure/RaTemplate.Persistence/Database/RaTemplateSqlServerDbContext.cs",
            "src/Core/RaTemplate.Application/Abstractions/Data/IRaTemplateSqlServerDbContext.cs"
          ]
        },
        {
          "condition": "(!UseEfOracle)",
          "exclude": [
            "src/Infrastructure/RaTemplate.Persistence/Database/RaTemplateOracleDbContext.cs",
            "src/Core/RaTemplate.Application/Abstractions/Data/IRaTemplateOracleDbContext.cs"
          ]
        },
        {
          "condition": "(!UseEfPostgres)",
          "exclude": [
            "src/Infrastructure/RaTemplate.Persistence/Database/RaTemplatePostgresDbContext.cs",
            "src/Core/RaTemplate.Application/Abstractions/Data/IRaTemplatePostgresDbContext.cs"
          ]
        },
        {
          "condition": "(!UseEfSqlite)",
          "exclude": [
            "src/Infrastructure/RaTemplate.Persistence/Database/RaTemplateSqliteDbContext.cs",
            "src/Core/RaTemplate.Application/Abstractions/Data/IRaTemplateSqliteDbContext.cs"
          ]
        },
        {
          "condition": "(!UseIntegrations)",
          "exclude": [
            "src/Infrastructure/RaTemplate.Integration/**"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "src/Presentation/RaTemplate.Api/RaTemplate.Api.csproj" },
    { "path": "README-template.md" }
  ],
  "postActions": [
    {
      "actionId": "D396686C-DE0E-4DE6-906A-29C1699A8DB6",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [ { "text": "Run 'dotnet restore'" } ],
      "continueOnError": true
    },
    {
      "description": "Opens README.md in the editor",
      "manualInstructions": [ ],
      "actionId": "84C0DA21-51C8-4541-9940-6CA19AF04EE6",
      "args": {
        "files": "1"
      },
      "continueOnError": true
    }
  ]
}
