{
//#if (UseAnyDatabase)
  "ConnectionStrings": {
    //#if (UseEfSqlServer)
    "RaTemplateSqlServerConnectionString": "Server=(localdb)\\mssqllocaldb;Database=RaTemplate;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=true",
    //#endif
    //#if (UseEfOracle)
    "RaTemplateOracleConnectionString": "Data Source=localhost:1521/XEPDB1;User Id=RaTemplate;Password=your_password;",
    //#endif
    //#if (UseEfPostgres)
    "RaTemplatePostgresConnectionString": "Host=localhost;Port=5432;Database=RaTemplate;Username=postgres;Password=your_password",
    //#endif
    //#if (UseEfSqlite)
    "RaTemplateSqliteConnectionString": "Data Source=RaTemplate.db"
    //#endif
  },
//#endif
//#if (UseAuthorization)
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "SaveToken": true,
        "Authority": "https://your-identity-provider.com/",
        "Audience": "your-api-audience",
        "ClaimsIssuer": null,
        "Challenge": "Bearer",
        "TokenValidationParameters": {
          "ValidateIssuer": true,
          "ValidIssuer": "https://your-identity-provider.com/",
          "ValidateAudience": true,
          "ValidAudience": "your-api-audience",
          "ValidateLifetime": true,
          "ValidateIssuerSigningKey": true,
          "ClockSkewInSeconds": 30,
          "IssuerSigningKeyString": "your-super-secret-key-that-is-at-least-32-bytes-long!!"
        }
      }
    }
  },
//#endif
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async",
      "Serilog.Enrichers.Sensitive",
      "Serilog.Exceptions"
    ],
    "Enrich": [
      { "Name": "WithExceptionDetails" },
      {
        "Name": "WithSensitiveDataMasking",
        "Args": {
          "options": {
            "MaskValue": "***SECRET***",
            "MaskProperties": [
              {
                "Name": "password"
              },
              {
                "Name": "Authorization",
                "Options": {
                  "ShowFirst": 7,
                  "PreserveLength": false
                }
              }
            ],
            "Mode": "Globally"
          }
        }
      }
    ],
    "WriteTo:Async": {
      "Name": "Async",
      "Args": {
        "configure": [
          {
            "Name": "File",
            "Args": {
              "rollingInterval": "Day",
              "path": "Logs/EventTest-.log",
              "outputTemplate": "{Timestamp:G} [{Level}] ({XRequestId})({TraceId}) {Message:lj} ({SourceContext}){NewLine}{Exception}",
              "retainedFileCountLimit": null,
              "rollOnFileSizeLimit": true
            }
          },
          {
            "Name": "Console",
            "Args": {
              "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
              "outputTemplate": "{Timestamp:G} [{Level}] ({XRequestId})({TraceId}) {Message:lj} ({SourceContext}){NewLine}{Exception}"
            }
          }
        ]
      }
    },
    "Properties": {
      "ApplicationName": "RaTemplate"
    }
  },
  "OpenApiInfoSettings": {
    "Title": "RaTemplate API",
    "Summary": "API interfaces for developers and agents.",
    "Description": "Api documentation interface for RaTemplate. Here you can read and try each endpoint.",
    "Contact": {
        "Name": "API Support Team",
        "Url": "https://example.com/support",
        "Email": "support@example.com"
      },
      "License": {
        "Name": "MIT License",
        "Url": "https://opensource.org/licenses/MIT"
      }
  }
}
